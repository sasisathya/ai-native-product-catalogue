# Application listener (inside container) and published host port.
PORT=4000
HOST_PORT=4000

# Server-side Fake Store API configuration.
FAKE_STORE_API_BASE_URL=https://fakestoreapi.com
PROVIDER_TIMEOUT_MS=5000
FEATURED_PRODUCT_IDS=1,2,3,4,5

# Local development uses the privacy-safe console adapter by default.
EMAIL_ADAPTER=console

# Optional SMTP configuration. Set EMAIL_ADAPTER=smtp to enable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
